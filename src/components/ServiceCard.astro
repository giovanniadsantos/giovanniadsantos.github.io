---
import { whatsappHref } from '../data/site';
import type { Service } from '../data/services';

interface Props {
  service: Service;
  index?: number;
}

const { service, index = 0 } = Astro.props;
const number = String(index + 1).padStart(2, '0');
const base = index * 80;
---

<div class="service-row">
  <div
    class="rule-draw"
    data-reveal
    style={`--reveal-delay: ${base}ms`}
    aria-hidden="true"
  >
  </div>
  {/* O link vive no <h3> para que o título volte à hierarquia de
      cabeçalhos e o texto âncora seja só o nome do serviço; o ::after
      dele se estica por cima da linha toda, então a área clicável
      continua sendo a mesma de antes. */}
  <div class="service-item" data-reveal style={`--reveal-delay: ${base + 40}ms`}>
    <span class="service-number" aria-hidden="true">{number}</span>
    <div class="service-body">
      <h3 class="service-title">
        <a
          class="service-link"
          href={whatsappHref(service.whatsappMessage)}
          target="_blank"
          rel="noopener noreferrer"
        >
          {service.title}
        </a>
      </h3>
      <p class="service-desc">{service.description}</p>
    </div>
    <span class="service-arrow" aria-hidden="true">→</span>
  </div>
</div>

<style>
  .service-row {
    display: flex;
    flex-direction: column;
  }

  .service-item {
    position: relative;
    display: flex;
    gap: 1.6rem;
    align-items: baseline;
    padding: 1.4rem 0;
    transition: background-color 0.2s linear;
  }

  .service-item:hover {
    background: var(--color-tag-bg);
  }

  .service-number {
    font-family: var(--font-heading);
    font-size: 0.82rem;
    color: var(--color-primary-text);
    width: 2.1rem;
    flex-shrink: 0;
  }

  .service-body {
    flex: 1;
    min-width: 0;
  }

  .service-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  /* Estica a área de clique do link por cima da linha inteira. */
  .service-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-top: 0.45rem;
    line-height: 1.6;
  }

  .service-arrow {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-rule);
    flex-shrink: 0;
    transition: color 0.2s linear, transform 0.2s cubic-bezier(0.2, 0, 0, 1);
  }

  .service-item:hover .service-arrow {
    color: var(--color-primary);
    transform: translateX(4px);
  }

  .service-item:hover .service-number {
    color: var(--color-primary-hover);
  }

  @media (max-width: 639px) {
    .service-item {
      gap: 1rem;
    }

    .service-number {
      width: 1.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-arrow,
    .service-item {
      transition: none;
    }
  }
</style>
