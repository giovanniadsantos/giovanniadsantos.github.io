---
import { whatsappHref } from '../data/site';
---

<a
  class="whatsapp-float"
  href={whatsappHref()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp"
>
  <svg viewBox="0 0 32 32" width="28" height="28" fill="currentColor" aria-hidden="true">
    <path
      d="M16.02 3C9.4 3 4.02 8.38 4.02 15c0 2.24.62 4.34 1.68 6.14L4 29l8.06-1.66A11.94 11.94 0 0 0 16.02 27C22.65 27 28 21.62 28 15S22.65 3 16.02 3Zm0 21.9c-1.86 0-3.6-.5-5.1-1.38l-.36-.21-4.5.93.96-4.38-.24-.38A9.86 9.86 0 0 1 6.12 15c0-5.46 4.45-9.9 9.9-9.9 5.46 0 9.9 4.44 9.9 9.9 0 5.46-4.44 9.9-9.9 9.9Zm5.44-7.42c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.24-.46-2.36-1.46-.87-.78-1.46-1.74-1.63-2.04-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.5h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.87 1.21 3.07c.15.2 2.09 3.19 5.06 4.47.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.13-.27-.2-.57-.35Z"
    />
  </svg>
</a>

<style>
  .whatsapp-float {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-whatsapp);
    color: #ffffff;
    box-shadow: var(--shadow-lift);
    transition: transform 0.25s ease, background-color 0.15s ease, opacity 0.25s ease;
  }

  /* Held back while the hero is on screen — its own WhatsApp button is
     right there, and a third identical CTA in the corner just competes
     with it. Only revealed once the visitor scrolls past. */
  .whatsapp-float.is-hidden {
    opacity: 0;
    transform: translateY(12px) scale(0.85);
    pointer-events: none;
  }

  .whatsapp-float:hover {
    background: var(--color-whatsapp-dark);
    transform: translateY(-2px) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-float {
      transition: opacity 0.25s ease;
    }

    .whatsapp-float.is-hidden {
      transform: none;
    }
  }
</style>

<script>
  const float = document.querySelector<HTMLElement>('.whatsapp-float');
  const hero = document.getElementById('top');

  if (float && hero && 'IntersectionObserver' in window) {
    float.classList.add('is-hidden');

    const observer = new IntersectionObserver(
      ([entry]) => float.classList.toggle('is-hidden', entry.isIntersecting),
      { threshold: 0.35 }
    );

    observer.observe(hero);
  }
</script>
