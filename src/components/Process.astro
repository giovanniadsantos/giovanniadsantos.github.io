---
const steps = [
  {
    number: '01',
    title: 'Conversa inicial',
    description: 'Você me chama no WhatsApp e me conta o que precisa. Sem burocracia.',
  },
  {
    number: '02',
    title: 'Proposta e prazo',
    description: 'Você recebe um escopo claro e um prazo realista, sem letras miúdas.',
  },
  {
    number: '03',
    title: 'Desenvolvimento',
    description: 'Eu construo o site ou sistema, com atualizações periódicas sobre o andamento.',
  },
  {
    number: '04',
    title: 'Entrega e suporte',
    description: 'Seu projeto vai ao ar, e eu continuo por perto para ajustes e suporte.',
  },
];
---

<section id="processo" class="section">
  <div class="container">
    <div class="section-header center" data-reveal>
      <span class="eyebrow">Como funciona</span>
      <h2>Um processo simples, do início ao fim</h2>
    </div>

    <div class="grid process-grid">
      <span class="process-connector" aria-hidden="true"></span>
      {steps.map((step, i) => (
        <div class="process-step" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <span class="process-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-grid {
    position: relative;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    padding-top: 0.5rem;
  }

  /* Runs through the vertical centre of the step numbers. Each number
     paints the section background behind itself so the dashes break
     cleanly around it, which reads as one continuous timeline. */
  .process-connector {
    position: absolute;
    left: 1.5rem;
    right: 1.5rem;
    top: 3.25rem;
    border-top: 2px dashed var(--color-border);
    z-index: 0;
  }

  /* Deliberately transparent: an opaque step background covered the
     connector everywhere except the column gaps, leaving three stray
     dashes floating between the steps. */
  .process-step {
    position: relative;
    z-index: 1;
    padding: 1.5rem;
  }

  .process-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--color-accent);
    opacity: 0.55;
    margin-bottom: 0.25rem;
    line-height: 1;
    background: var(--color-bg);
    padding-right: 0.85rem;
  }

  .process-step h3 {
    margin-bottom: 0.5rem;
  }

  @media (max-width: 939px) {
    .process-connector {
      display: none;
    }

    .process-number {
      background: none;
      padding-right: 0;
    }
  }
</style>
