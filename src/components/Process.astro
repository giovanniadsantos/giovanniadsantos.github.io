---
const steps = [
  {
    number: '01',
    title: 'Conversa inicial',
    description: 'Você me chama no WhatsApp e me conta o que precisa. Sem burocracia.',
  },
  {
    number: '02',
    title: 'Proposta e prazo',
    description: 'Você recebe um escopo claro e um prazo realista, sem letras miúdas.',
  },
  {
    number: '03',
    title: 'Desenvolvimento',
    description: 'Eu construo o site ou sistema, com atualizações periódicas sobre o andamento.',
  },
  {
    number: '04',
    title: 'Entrega e suporte',
    description: 'Seu projeto vai ao ar, e eu continuo por perto para ajustes e suporte.',
  },
];
---

<section id="processo" class="section">
  <div class="container">
    <div class="section-header center" data-reveal>
      <span class="eyebrow">Como funciona</span>
      <h2>Um processo simples, do início ao fim</h2>
    </div>

    <div class="grid process-grid">
      <span class="process-connector" aria-hidden="true"></span>
      {steps.map((step, i) => (
        <div class="process-step" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
          <span class="process-number">{step.number}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-grid {
    position: relative;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    padding-top: 0.5rem;
  }

  .process-connector {
    position: absolute;
    left: 0;
    right: 0;
    top: 3.25rem;
    border-top: 2px dashed var(--color-border);
    z-index: 0;
  }

  .process-step {
    position: relative;
    z-index: 1;
    background: var(--color-bg);
    padding: 1.5rem;
  }

  .process-number {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--color-accent);
    opacity: 0.4;
    margin-bottom: 0.25rem;
    line-height: 1;
  }

  .process-step h3 {
    margin-bottom: 0.5rem;
  }

  @media (min-width: 861px) {
    .process-step:nth-child(3) {
      transform: translateY(30px);
    }

    .process-step:nth-child(5) {
      transform: translateY(30px);
    }
  }

  @media (max-width: 860px) {
    .process-connector {
      display: none;
    }
  }
</style>
