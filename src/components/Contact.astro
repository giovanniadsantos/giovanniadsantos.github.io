---
import { whatsappHref } from '../data/site';
---

<section id="contato" class="section">
  <div class="container">
    <div class="contact-block" data-reveal>
      <div class="contact-copy">
        <span class="eyebrow">Contato</span>
        <h2>Vamos conversar sobre o seu projeto?</h2>
        <p>Me chame no WhatsApp e me conte a sua ideia — respondo rápido e sem compromisso.</p>
      </div>
      <a class="btn btn-whatsapp" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
        Falar no WhatsApp →
      </a>
    </div>
  </div>
</section>

<style>
  /* A bordered plate instead of the old radial glow: in this system
     depth comes from hairlines, not from blurred light. */
  .contact-block {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }

  .contact-copy {
    max-width: 46ch;
  }

  .contact-copy h2 {
    margin-block: 0.4rem 0.75rem;
  }

  .contact-copy p {
    font-size: 1.02rem;
  }
</style>
