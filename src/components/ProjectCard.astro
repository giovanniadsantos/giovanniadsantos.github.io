---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index?: number;
  featured?: boolean;
  /** Runs the card across the full grid row (set by Projects.astro). */
  wide?: boolean;
}

const { project, index = 0, featured = false, wide = false } = Astro.props;
const gradient = `linear-gradient(135deg, ${project.accentFrom}, ${project.accentTo})`;
const host = new URL(project.url).hostname.replace(/^www\./, '');
---

<article
  class:list={['card', 'project-card', { 'is-wide': wide }]}
  data-reveal
  style={`--reveal-delay: ${index * 90}ms`}
>
  {/* A capa deixou de ser um link próprio: antes o card tinha dois
      links para o mesmo destino, e o da capa se anunciava como
      "Captura de tela do site X" — que descreve a imagem, não para
      onde leva. Agora o link vive no título e se estica por cima do
      card inteiro, então a capa continua clicável. */}
  <div
    class="project-thumb"
    style={!project.image ? `background-image: ${gradient}` : undefined}
  >
    {project.image ? (
      <Image
        class="project-thumb-image"
        src={project.image}
        alt={`Captura de tela do site ${project.name}`}
        width={840}
        height={500}
      />
    ) : (
      <span class="project-thumb-name">{project.name}</span>
    )}

    {/* Mira: entra no hover no lugar do zoom. */}
    <span class="mira mira-tl" aria-hidden="true"></span>
    <span class="mira mira-tr" aria-hidden="true"></span>
    <span class="mira mira-bl" aria-hidden="true"></span>
    <span class="mira mira-br" aria-hidden="true"></span>

    {featured && <span class="project-featured-tag">Destaque</span>}
  </div>

  <div class="project-body">
    <span class="tag">{project.category}</span>
    <div class="project-head">
      <h3>
        <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
          {project.name}
        </a>
      </h3>
      <span class="project-host">{host}</span>
    </div>
    <p>{project.tagline}</p>
    <span class="project-cta" aria-hidden="true">Visitar site →</span>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color 0.25s linear;
  }

  .project-card:hover {
    border-color: var(--color-primary);
  }

  .project-thumb {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .project-thumb-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    /* --shot-dim is set per theme in global.css: these are screenshots
       of light-themed sites and they glare against the dark page. */
    filter: var(--shot-dim, none);
    transition: filter 0.3s linear;
  }

  .project-card:hover .project-thumb-image {
    filter: none;
  }

  /* ---------- mira ---------- */
  .mira {
    position: absolute;
    z-index: 2;
    width: 15px;
    height: 15px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s linear, transform 0.22s cubic-bezier(0.2, 0, 0, 1);
  }

  .mira-tl {
    top: 10px;
    left: 10px;
    border-top: 1.5px solid var(--color-primary);
    border-left: 1.5px solid var(--color-primary);
    transform: translate(7px, 7px);
  }

  .mira-tr {
    top: 10px;
    right: 10px;
    border-top: 1.5px solid var(--color-primary);
    border-right: 1.5px solid var(--color-primary);
    transform: translate(-7px, 7px);
  }

  .mira-bl {
    bottom: 10px;
    left: 10px;
    border-bottom: 1.5px solid var(--color-primary);
    border-left: 1.5px solid var(--color-primary);
    transform: translate(7px, -7px);
  }

  .mira-br {
    bottom: 10px;
    right: 10px;
    border-bottom: 1.5px solid var(--color-primary);
    border-right: 1.5px solid var(--color-primary);
    transform: translate(-7px, -7px);
  }

  .project-card:hover .mira {
    opacity: 1;
    transform: translate(0, 0);
  }

  .project-thumb-name {
    position: relative;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    color: #ffffff;
  }

  .project-featured-tag {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 2;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
  }

  .project-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* Lets the link sit on the baseline of the tallest card in the row
       instead of leaving a pocket of dead space beneath it. */
    flex: 1;
  }

  /* Without this the pill stretches to the full card width as a flex
     item and reads as a bar rather than a tag. */
  .project-body :global(.tag) {
    align-self: flex-start;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }

  .project-head h3 {
    margin: 0;
  }

  .project-host {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), color 0.25s linear;
  }

  .project-card:hover .project-host {
    transform: translateX(-4px);
    color: var(--color-primary-text);
  }

  .project-body p {
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .project-head h3 a {
    color: inherit;
  }

  /* Estica a área de clique do link por cima do card inteiro. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
  }

  .project-card:hover .project-head h3 a {
    color: var(--color-primary-text);
  }

  /* Pista visual, não link: o card inteiro já é clicável, e um segundo
     link para o mesmo destino só repetiria o item na navegação. */
  .project-cta {
    margin-top: auto;
    padding-top: 0.9rem;
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-primary-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .mira,
    .project-host,
    .project-thumb-image,
    .project-card {
      transition: none;
    }
  }
</style>
