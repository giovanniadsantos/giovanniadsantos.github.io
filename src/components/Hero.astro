---
import { Image } from 'astro:assets';
import { whatsappHref } from '../data/site';
import { projects, type Project } from '../data/projects';

const showcaseProjects = projects.filter(
  (project): project is Project & { image: NonNullable<Project['image']> } => Boolean(project.image)
);

const hostFor = (url: string) => new URL(url).hostname.replace(/^www\./, '');

/* Each value is rendered in full server-side; the scramble only ever
   replaces text that is already there, so it survives JS being off. */
const stats = [
  { value: '10+', label: 'anos com desenvolvimento' },
  { value: String(projects.length).padStart(2, '0'), label: 'projetos no ar' },
  { value: '1:1', label: 'você fala comigo' },
  { value: 'BR', label: 'atendimento remoto' },
];
---

<section id="top" class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <!-- Marcas de registro: traçam como a ponta de um plotter. -->
      <svg class="reg reg-a" viewBox="0 0 30 30" aria-hidden="true">
        <path
          class="anim-tracar"
          d="M0 23 L0 0 L23 0"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="46"
        ></path>
      </svg>
      <svg class="reg reg-b" viewBox="0 0 30 30" aria-hidden="true">
        <path
          class="anim-tracar"
          style="--anim-delay: 90ms"
          d="M30 23 L30 0 L7 0"
          fill="none"
          stroke="currentColor"
          stroke-width="1"
          stroke-dasharray="46"
        ></path>
      </svg>

      <span class="hero-fig anim-surgir" style="--anim-delay: 240ms">
        <span>FIG. 01</span>
        <span class="hero-fig-rule" aria-hidden="true"></span>
        <span>Desenvolvimento web sob medida</span>
      </span>

      {/* Os {' '} são obrigatórios: o compilador remove o espaço entre
          os <span>, e sem eles o texto acessível do H1 sai colado
          ("sistemaspara o seunegócio"), justamente sobre a frase
          comercial. Visualmente nada muda, porque cada span é block. */}
      <h1>
        <span class="anim-assentar" style="--anim-delay: 420ms">Sem enrolação:</span>{' '}
        <span class="anim-assentar" style="--anim-delay: 500ms">sites e sistemas</span>{' '}
        <span class="anim-assentar" style="--anim-delay: 580ms">para o seu</span>{' '}
        <span class="anim-assentar" style="--anim-delay: 660ms">
          <span class="highlight">negócio ou comunidade</span>
        </span>
      </h1>

      <!-- Linha de cota: mede do centro para fora e trava nas pontas. -->
      <div class="hero-cota" aria-hidden="true">
        <span class="cota-tick anim-travar" style="--anim-delay: 760ms"></span>
        <span class="cota-line anim-medir" style="--anim-delay: 380ms; transform-origin: right center"></span>
        <span class="cota-label anim-surgir" style="--anim-delay: 300ms">ENTREGA DIRETA</span>
        <span class="cota-line anim-medir" style="--anim-delay: 380ms; transform-origin: left center"></span>
        <span class="cota-tick anim-travar" style="--anim-delay: 760ms"></span>
      </div>

      <p class="anim-assentar" style="--anim-delay: 900ms">
        Você fala direto comigo pelo WhatsApp, do orçamento à entrega — sem intermediário e sem
        sumiço.
      </p>

      <div class="hero-actions anim-assentar" style="--anim-delay: 1000ms">
        <a class="btn btn-whatsapp" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
          Falar no WhatsApp
        </a>
        <a class="btn btn-outline" href="#projetos">Ver projetos →</a>
      </div>
    </div>

    {showcaseProjects.length > 0 && (
      <div class="hero-showcase anim-assentar" style="--anim-delay: 320ms">
        <span class="showcase-badge">Projetos reais no ar</span>
        <div class="browser-frame">
          <div class="browser-bar">
            <span class="browser-sq" aria-hidden="true"></span>
            <span class="browser-sq" aria-hidden="true"></span>
            <span class="browser-sq" aria-hidden="true"></span>
            <span class="browser-url">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 5.5V4a3 3 0 0 1 6 0v1.5M2.75 5.5h6.5c.41 0 .75.34.75.75v3.5c0 .41-.34.75-.75.75h-6.5A.75.75 0 0 1 2 9.75v-3.5c0-.41.34-.75.75-.75Z" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span data-url-display>{hostFor(showcaseProjects[0].url)}</span>
            </span>
          </div>
          <div class="browser-viewport">
            {showcaseProjects.map((project, i) => (
              <Image
                src={project.image}
                alt={`Captura de tela do site ${project.name}`}
                width={900}
                height={563}
                loading={i === 0 ? 'eager' : 'lazy'}
                class:list={['showcase-slide', { 'is-active': i === 0 }]}
                data-slide
                data-host={hostFor(project.url)}
              />
            ))}
          </div>
        </div>
        <div class="showcase-dots" role="group" aria-label="Selecionar projeto em destaque">
          {showcaseProjects.map((project, i) => (
            <button
              type="button"
              class:list={['showcase-dot', { 'is-active': i === 0 }]}
              data-dot
              aria-label={`Mostrar ${project.name}`}
              aria-current={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>
    )}
  </div>

  <div class="container">
    <div class="hero-stats anim-surgir" style="--anim-delay: 1050ms" data-stats>
      {stats.map((stat) => (
        <div class="stat">
          <span class="stat-value" data-stat={stat.value}>{stat.value}</span>
          <span class="stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  /* ---- carrossel do hero ---- */
  const showcases = document.querySelectorAll<HTMLElement>('.hero-showcase');

  showcases.forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const urlDisplay = root.querySelector<HTMLElement>('[data-url-display]');
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (slides.length < 2) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;

    const show = (index: number) => {
      const next = (index + slides.length) % slides.length;
      if (next === current) return;

      slides[current]?.classList.remove('is-active');
      dots[current]?.classList.remove('is-active');
      dots[current]?.setAttribute('aria-current', 'false');

      current = next;

      slides[current]?.classList.add('is-active');
      dots[current]?.classList.add('is-active');
      dots[current]?.setAttribute('aria-current', 'true');
      if (urlDisplay) urlDisplay.textContent = slides[current]?.dataset.host ?? '';
    };

    const INTERVALO = 4200;
    const GATILHOS = ['pointerdown', 'keydown', 'wheel', 'touchstart'];

    /* A rotação só começa depois da primeira interação do visitante.
       Cada slide novo é um candidato a Largest Contentful Paint, e o
       Chrome só encerra essa medição na primeira interação — então
       qualquer troca antes disso entra na métrica. Medido nesta página:
       girando desde o início o LCP ia a 5,3s; com um atraso fixo de 9s
       chegava a 13,6s para quem não interagia (a troca caía depois da
       espera, e contava do mesmo jeito). Atrelado à interação, o LCP
       fica em ~0,7s, e quem rola a página continua vendo o carrossel. */
    let liberado = false;

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
    };

    const girar = () => {
      stop();
      timer = setInterval(() => show(current + 1), INTERVALO);
    };

    const start = () => {
      if (prefersReduced || !liberado) return;
      girar();
    };

    const liberar = () => {
      if (liberado || prefersReduced) return;
      liberado = true;
      GATILHOS.forEach((evento) => window.removeEventListener(evento, liberar));
      if (!document.hidden) girar();
    };

    if (!prefersReduced) {
      GATILHOS.forEach((evento) =>
        window.addEventListener(evento, liberar, { passive: true })
      );
    }

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        liberar();
        show(i);
        start();
      });
    });

    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  });

  /* ---- números travando em leitura ----
     Só na primeira visita: depois disso o truque vira ruído para quem
     já viu. O valor final já está no DOM, então sem JS (ou com a flag
     gravada) os números simplesmente aparecem prontos. */
  const strip = document.querySelector<HTMLElement>('[data-stats]');
  const SEEN_KEY = 'ga:stats-scrambled';

  if (strip) {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let alreadySeen = false;
    try {
      alreadySeen = localStorage.getItem(SEEN_KEY) === '1';
    } catch {
      /* armazenamento bloqueado: trata como já visto e não anima */
      alreadySeen = true;
    }

    if (!prefersReduced && !alreadySeen) {
      const chars = '0123456789+:/#%&*';
      const values = Array.from(strip.querySelectorAll<HTMLElement>('[data-stat]'));

      values.forEach((el, i) => {
        const final = el.dataset.stat ?? el.textContent ?? '';
        let step = 0;

        setTimeout(() => {
          const spin = setInterval(() => {
            step += 1;
            if (step > 7) {
              clearInterval(spin);
              el.textContent = final;
              return;
            }
            // as posições travam da esquerda para a direita
            el.textContent = final
              .split('')
              .map((char, j) =>
                j < step - 3 ? char : chars.charAt(Math.floor(Math.random() * chars.length))
              )
              .join('');
          }, 55);
        }, 1150 + i * 90);
      });

      try {
        localStorage.setItem(SEEN_KEY, '1');
      } catch {
        /* sem persistência: anima de novo na próxima visita, sem quebrar */
      }
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem) clamp(2.5rem, 5vw, 4rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 5vw, 3.5rem);
  }

  .hero-copy {
    position: relative;
    padding-top: 1.75rem;
  }

  /* marcas de registro */
  .reg {
    position: absolute;
    top: 0;
    width: 30px;
    height: 30px;
    color: var(--color-primary);
    overflow: visible;
  }

  .reg-a {
    left: 0;
  }

  .reg-b {
    right: 0;
  }

  .hero-fig {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-text);
    margin-bottom: 1.75rem;
  }

  .hero-fig > span:first-child {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .hero-fig-rule {
    width: 40px;
    height: 1px;
    background: currentColor;
    flex-shrink: 0;
  }

  /* Abaixo de sm o rótulo completo não cabe ao lado do fio sem quebrar
     "FIG. 01" no meio. */
  @media (max-width: 639px) {
    .hero-fig {
      gap: 0.6rem;
      font-size: 0.68rem;
    }

    .hero-fig-rule {
      width: 20px;
    }
  }

  .hero-copy h1 {
    margin: 0;
    font-size: clamp(1.85rem, 2.4vw + 1rem, 2.9rem);
    line-height: 1.08;
  }

  .hero-copy h1 span {
    display: block;
  }

  .highlight {
    display: inline;
    color: var(--color-primary-text);
  }

  /* linha de cota */
  .hero-cota {
    display: flex;
    align-items: center;
    margin-top: 1.5rem;
    max-width: 480px;
    color: var(--color-primary);
  }

  .cota-tick {
    width: 1px;
    height: 12px;
    background: currentColor;
    flex-shrink: 0;
  }

  .cota-line {
    flex: 1;
    height: 1px;
    background: currentColor;
  }

  .cota-label {
    font-family: var(--font-heading);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    padding: 0 0.7rem;
    white-space: nowrap;
  }

  .hero-copy p {
    font-size: 1.08rem;
    line-height: 1.65;
    max-width: 50ch;
    margin-top: 1.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.25rem;
  }

  /* ---------- showcase ---------- */
  .hero-showcase {
    position: relative;
    width: min(100%, 520px);
    margin-inline: auto;
  }

  .showcase-badge {
    position: absolute;
    top: -0.75rem;
    left: 1.25rem;
    z-index: 3;
    background: var(--color-badge-bg);
    color: var(--color-badge-text);
    font-family: var(--font-heading);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.4rem 0.8rem;
  }

  .browser-frame {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .browser-sq {
    width: 7px;
    height: 7px;
    background: var(--color-rule);
    flex-shrink: 0;
  }

  .browser-url {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: 0.6rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
    font-size: 0.68rem;
    max-width: 100%;
    overflow: hidden;
  }

  .browser-url svg {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    color: var(--color-primary);
  }

  .browser-url span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .browser-viewport {
    position: relative;
    aspect-ratio: 900 / 563;
    background: var(--color-bg-alt);
    overflow: hidden;
  }

  .showcase-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    filter: var(--shot-dim, none);
    transition: opacity 0.8s linear;
  }

  .showcase-slide.is-active {
    opacity: 1;
    z-index: 1;
  }

  .showcase-dots {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }

  .showcase-dot {
    width: 22px;
    height: 3px;
    padding: 0;
    border: none;
    background: var(--color-border);
    cursor: pointer;
    transition: background-color 0.25s linear;
  }

  .showcase-dot:hover {
    background: var(--color-rule);
  }

  .showcase-dot.is-active {
    background: var(--color-primary);
  }

  /* ---------- faixa de números ---------- */
  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .stat {
    background: var(--color-bg);
    padding: 1.25rem 1.15rem;
  }

  .stat-value {
    display: block;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-primary-text);
  }

  .stat-label {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    margin-top: 0.45rem;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-slide,
    .showcase-dot {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 940px) {
    .hero-inner {
      flex-direction: row;
      align-items: center;
      gap: clamp(2.5rem, 4vw, 4rem);
    }

    .hero-copy {
      flex: 1.1;
    }

    .hero-showcase {
      flex: 0.9;
      width: 100%;
      max-width: 520px;
      margin-inline: 0;
    }
  }
</style>
