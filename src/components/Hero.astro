---
import { Image } from 'astro:assets';
import profile from '../assets/images/profile.jpg';
import { whatsappHref } from '../data/site';
---

<section id="top" class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">Desenvolvimento web sob medida</span>
      <h1>Sites e sistemas para o seu negócio ou comunidade</h1>
      <p>
        Desenvolvo catálogos, sites institucionais e ferramentas personalizadas — do primeiro
        contato à entrega, com comunicação direta pelo WhatsApp.
      </p>
      <div class="hero-actions">
        <a class="btn btn-whatsapp" href={whatsappHref()} target="_blank" rel="noopener noreferrer">
          Falar no WhatsApp
        </a>
        <a class="btn btn-outline" href="#projetos">Ver projetos</a>
      </div>
    </div>

    <div class="hero-photo">
      <Image src={profile} alt="Foto de Giovanni Angelo" width={420} height={420} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(3rem, 6vw, 5rem);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .hero-copy h1 {
    margin-block: 0.5rem 1.25rem;
  }

  .hero-copy p {
    font-size: 1.15rem;
    max-width: 46ch;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .hero-photo {
    justify-self: center;
  }

  .hero-photo :global(img) {
    width: min(320px, 70vw);
    height: min(320px, 70vw);
    object-fit: cover;
    border-radius: 50%;
    border: 6px solid var(--color-surface);
    box-shadow: var(--shadow-lift);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-copy p {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-photo {
      order: -1;
    }
  }
</style>
