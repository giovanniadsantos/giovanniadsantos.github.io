---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';
---

<section id="projetos" class="section section-alt">
  <div class="container">
    <div class="section-header center" data-reveal>
      <span class="eyebrow">Projetos</span>
      <h2>Alguns projetos que já coloquei no ar</h2>
      <p>Sites e sistemas reais, em uso hoje por comunidades e negócios.</p>
    </div>

    <div class="grid projects-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} featured={i === 0} />
      ))}
    </div>
  </div>
</section>

<style>
  /* Two explicit columns rather than auto-fit: with auto-fit the track
     count drifted to three, and since the featured card spans two the
     third project was left orphaned beside two empty columns. */
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .projects-grid > :global(.project-card:first-child) {
    grid-column: 1 / -1;
  }

  /* .project-thumb belongs to ProjectCard.astro, so it carries that
     component's scope hash — it needs :global() here or the selector
     silently never matches. */
  .projects-grid > :global(.project-card:first-child .project-thumb) {
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 779px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .projects-grid > :global(.project-card:first-child .project-thumb) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
