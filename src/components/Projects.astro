---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

/* The grid is two columns wide and the lead project always takes a full
   row. That leaves the remaining projects to pair up — so when there is
   an odd number of them, the last one would sit alone beside an empty
   column. Giving that one a full row too turns the leftover into a
   deliberate wide/narrow-narrow/wide rhythm, and the rule keeps holding
   as projects are added. */
const lastIndex = projects.length - 1;
const isWide = (index: number) =>
  index === 0 || (index === lastIndex && (projects.length - 1) % 2 === 1);
---

<section id="projetos" class="section section-alt">
  <div class="container">
    <div class="section-header center" data-reveal>
      <span class="eyebrow">Projetos</span>
      <h2>Alguns projetos que já coloquei no ar</h2>
      <p>Sites e sistemas reais, em uso hoje por comunidades e negócios.</p>
    </div>

    <div class="grid projects-grid">
      {projects.map((project, i) => (
        <ProjectCard project={project} index={i} featured={i === 0} wide={isWide(i)} />
      ))}
    </div>
  </div>
</section>

<style>
  /* Two explicit columns rather than auto-fit: with auto-fit the track
     count drifted to three, and since the lead card spans two the third
     project was left orphaned beside two empty columns. */
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .projects-grid > :global(.project-card.is-wide) {
    grid-column: 1 / -1;
  }

  /* .project-thumb belongs to ProjectCard.astro, so it carries that
     component's scope hash — it needs :global() here or the selector
     silently never matches. */
  .projects-grid > :global(.project-card.is-wide .project-thumb) {
    aspect-ratio: 21 / 9;
  }

  @media (max-width: 779px) {
    .projects-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .projects-grid > :global(.project-card.is-wide .project-thumb) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
